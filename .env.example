# Copy to .env.local and fill in. Everything except AUTH_SECRET is optional in local dev.

# ── App ──────────────────────────────────────────────────────────────
# Public base URL, used in links inside emails.
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────
# Leave empty in local dev: an embedded Postgres (PGlite) is created in ./.data/pglite.
# In production set a real Postgres with the pgvector extension (Neon, Supabase, RDS, college server).
# For poolers in transaction mode (Supabase :6543, Neon -pooler) this still works: prepared statements are disabled.
DATABASE_URL=

# ── Auth (Google Workspace) ─────────────────────────────────────────
# Generate with: npx auth secret   (or any random 32+ char string)
AUTH_SECRET=
# Google OAuth client (console.cloud.google.com → Credentials → OAuth client ID → Web).
# Redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only accounts on this Google Workspace domain can sign in.
ALLOWED_EMAIL_DOMAIN=dau.ac.in
# Comma-separated outside accounts that may also sign in (e.g. a mess contractor). Optional.
EXTRA_ALLOWED_EMAILS=
# Comma-separated emails that become admins on sign-in.
ADMIN_EMAILS=
# Local dev only: shows an "email-only" sign-in form so you can act as any user. Ignored in production.
AUTH_DEV_LOGIN=true

# ── AI (Gemini) ──────────────────────────────────────────────────────
GEMINI_API_KEY=
# Classification models tried in order (fallbacks when one is overloaded).
GEMINI_MODELS=gemini-2.5-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Email ────────────────────────────────────────────────────────────
# console = print emails to the server log (dev). smtp = send for real.
EMAIL_TRANSPORT=console
# e.g. smtps://user%40dau.ac.in:app-password@smtp.gmail.com:465
SMTP_URL=
EMAIL_FROM="DAU Pulse <pulse@dau.ac.in>"

# ── Scheduled jobs ───────────────────────────────────────────────────
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token automatically).
CRON_SECRET=
